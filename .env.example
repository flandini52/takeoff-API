# ==============================================================================
# AMBIENTE
# ==============================================================================
# DASHBOARD_ENV: "development" o "production" — non cambia la connessione al
# database, solo cosa viene mostrato/loggato (vedi ENABLE_SCADENZE sotto).
#
# ENABLE_SCADENZE: mostra la pagina "Scadenze dipendenti" in Streamlit.
# Default false: quella pagina resta nascosta finché non c'è il login (V2) —
# vedi streamlit/app/main.py e utils/access.py. Impostare a true solo per
# testarla in locale.
#
# Decommenta UNO dei due blocchi sotto e commenta l'altro.

# --- Sviluppo (locale: Docker Compose o esecuzione nativa) ---
DASHBOARD_ENV=development
ENABLE_SCADENZE=false

# --- Produzione (Windows Server nativo — vedi DEPLOY_WINDOWS.md) ---
# DASHBOARD_ENV=production
# ENABLE_SCADENZE=false

# ==============================================================================
# PostgreSQL (landini-dashboard: etl + streamlit)
# ==============================================================================
# DB_HOST/DB_PORT sono gli stessi in sviluppo e produzione (localhost:5435):
# in produzione perché è lì che ascolta il Postgres nativo su Windows; in
# sviluppo perché docker-compose.yml pubblica il Postgres del container
# sullo stesso host:porta (vedi README, "Avviare Docker Compose"). Dentro i
# container Docker, DB_HOST/DB_PORT vengono comunque sovrascritti da
# docker-compose.yml (rete Docker interna: "postgres"/5432) — i valori qui
# sotto contano per l'esecuzione nativa (dev o produzione) e per un client
# esterno (psql, pgAdmin).
DB_HOST=localhost
DB_PORT=5435
DB_NAME=landini_dashboard

# Admin/bootstrap (POSTGRES_USER/POSTGRES_PASSWORD del container in
# sviluppo; su Windows nativo è l'utente "postgres" già installato — vedi
# deploy/windows/init_db.ps1). Nessun servizio applicativo si connette con
# queste credenziali, solo l'inizializzazione/migrazione del database.
DB_USER=landini
DB_PASSWORD=

# Due ruoli creati da database/init/001_roles.sql, uno per consumatore:
# etl_writer (lettura/scrittura, usato dall'ETL) e dashboard_reader (sola
# lettura, usato da Streamlit). Nessuno dei due si connette come utente
# admin. Prendono effetto solo su un database/volume nuovo.
ETL_WRITER_PASSWORD=
DASHBOARD_READER_PASSWORD=

# ==============================================================================
# Takeoff CRM (gestionale) — usato da src/landini_etl
# ==============================================================================
# API base URL (di solito non serve cambiarla)
TAKEOFF_BASE_URL=https://webapi.takeoffcrm.com

# Autenticazione: impostane UNA delle due (x-api-key oppure Bearer JWT)
TAKEOFF_API_KEY=
TAKEOFF_TOKEN=

# ==============================================================================
# Backup (deploy/windows/backup_db.ps1) — solo produzione Windows
# ==============================================================================
# Cartella di destinazione dei backup (pg_dump). Se non raggiungibile,
# backup_db.ps1 usa un fallback locale sotto logs/ — vedi DEPLOY_WINDOWS.md.
# BACKUP_DIR=Z:\lavori\backup-dashboard\
