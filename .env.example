# --- PostgreSQL (landini-dashboard: etl + streamlit) ---
# DB_HOST is overridden to "postgres" by docker-compose.yml for the
# streamlit/etl containers (Docker network service name). Only change it
# here if you run those apps outside Docker (e.g. "localhost").
DB_HOST=postgres
DB_PORT=5432
DB_NAME=landini_dashboard
DB_USER=landini
DB_PASSWORD=

# --- Gestionale API (used by the ETL; not documented/implemented yet) ---
GESTIONALE_API_URL=
GESTIONALE_API_KEY=

# --- Takeoff CRM extraction toolkit (root scripts: takeoff_client.py, ---
# --- extract_data.py, and the two standalone SQLite pipelines)        ---
# API base URL (usually no need to change this)
TAKEOFF_BASE_URL=https://webapi.takeoffcrm.com

# Authentication: set ONE of the two (x-api-key or Bearer JWT)
TAKEOFF_API_KEY=
TAKEOFF_TOKEN=
