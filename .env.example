# --- PostgreSQL (landini-dashboard: etl + streamlit) ---
# DB_HOST is overridden to "postgres" by docker-compose.yml for the
# streamlit/etl containers (Docker network service name). Only change it
# here if you run those apps outside Docker (e.g. "localhost").
# DB_PORT=5435 matches native Windows production (see DEPLOY_WINDOWS.md) —
# docker-compose.yml publishes the dev Postgres on this same host port, so
# an external client (psql, pgAdmin, a native non-Docker run of this app)
# connects identically in dev and in production.
DB_HOST=postgres
DB_PORT=5435
DB_NAME=landini_dashboard

# Admin/bootstrap user (POSTGRES_USER/POSTGRES_PASSWORD for the postgres
# image itself). Neither the ETL nor Streamlit connect as this user — see
# ETL_WRITER_PASSWORD / DASHBOARD_READER_PASSWORD below.
DB_USER=landini
DB_PASSWORD=

# Two roles created by database/init/001_roles.sql, one per consumer:
# etl_writer (read/write, used by the ETL) and dashboard_reader (read-only,
# used by Streamlit). Only take effect on a fresh volume (see README,
# "Ricreare il database in sviluppo").
ETL_WRITER_PASSWORD=
DASHBOARD_READER_PASSWORD=

# --- Takeoff CRM (gestionale) — used by etl/app (and, until the section 6 ---
# --- cleanup, by the legacy root scripts too)                             ---
# API base URL (usually no need to change this)
TAKEOFF_BASE_URL=https://webapi.takeoffcrm.com

# Authentication: set ONE of the two (x-api-key or Bearer JWT)
TAKEOFF_API_KEY=
TAKEOFF_TOKEN=
